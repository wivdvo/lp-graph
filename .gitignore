# build output
/target/

# built programs (build with `cargo build --release`, then copy to bin/)
/bin/*.exe

# tracker data in bin/data/ IS committed on purpose

# but not the tracker's log or its local on/off switches
/bin/data/tracker.log
/bin/data/tracker.log.old
/bin/data/no-sync
/bin/data/no-autostart
/bin/data/sync-status.json
/bin/data/history_cache.json
/bin/data/no-notify

# installer output
/dist/
/bin/data/hide-estimates
/bin/data/eog-last.json
